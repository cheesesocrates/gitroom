# Copy to .env.local. All optional in development.

# Reads public GitHub data for everyone's houses. In dev, GitRoom borrows `gh auth token` if this is empty.
# In production use a classic token with no scopes: it can only read public data.
GITHUB_TOKEN=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps), callback URL: http://localhost:3000/api/auth/callback
# Without these, "Sign in with GitHub" on localhost signs you in as the GitHub CLI account (development only).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie and private-repo ids. Required in production; any long random string.
SESSION_SECRET=

# Where owners' house settings are saved on serverless hosts like Vercel. Without these they go to data/houses/.
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; those work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
